# FastAPI server
# 로컬 직접 실행: http://localhost:8080
# Docker Compose 실행: http://spring-app:8080
API_BASE_URL=http://localhost:8080

# AWS S3 image access
AWS_ACCESS_KEY=<aws-access-key>
AWS_ACCESS_SECRETKEY=<aws-secret-key>
AWS_BUCKET=<s3-bucket-name>
AWS_REGION=ap-northeast-2

# OpenAI API
OPENAI_API_KEY=<openai-api-key>
