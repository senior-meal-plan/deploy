# Database
# Docker Compose에서 호스트 MySQL을 사용할 경우 <mysql-host>에 host.docker.internal 또는 RDS 엔드포인트를 넣습니다.
RDB.local=jdbc:mysql://<mysql-host>:3306/<database-name>?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
RDB.user.local=<mysql-username>
RDB.PASSWORD.local=<mysql-password>
ddl-auto=update

# JWT
# 예: openssl rand -base64 32
jwt.secret=<base64-encoded-256-bit-secret>
jwt.exp-minutes=60

# AWS S3
aws.access.key=<aws-access-key>
aws.access.secretkey=<aws-secret-key>

# Redis
# 로컬 직접 실행: localhost
# Docker Compose 실행: redis
redis.host=localhost

# FastAPI analysis server
# 로컬 직접 실행: http://localhost:8000
# Docker Compose 실행: http://fastapi-app:8000
meal.analysis.url=http://localhost:8000/meals/analyze-and-send
daily.analysis.url=http://localhost:8000/daily/analyze-and-send
weekly.analysis.url=http://localhost:8000/weekly/analyze-and-send

# Spring Boot webhook base URL passed to the analysis flow
# 로컬 직접 실행: http://localhost:8080
# Docker Compose 실행: http://spring-app:8080
webhook.callback-url=http://localhost:8080

# Kakao OAuth2
kakao.client.id=<kakao-rest-api-key>
kakao.redirect-uri=http://localhost:8080/login/oauth2/code/kakao
